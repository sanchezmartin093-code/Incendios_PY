# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches and environments
.env
.venv
env/
venv/
ENV/
.pytest_cache/
.ipynb_checkpoints/
.quarto/

# Mac OS files
.DS_Store

# Heavy raw and intermediate geospatial data
datos/raw/*
!datos/raw/.gitkeep
datos/processed/*
!datos/processed/.gitkeep
datos/outputs/*
!datos/outputs/.gitkeep

# Serialized heavy models (track schema/config, ignore large binaries)
modelos/*.booster
modelos/*.pkl
!modelos/.gitkeep
modelos/calibradores/*
!modelos/calibradores/.gitkeep

/.quarto/
_output/
dist/
**/*.quarto_ipynb
*_files/
*.html.md
# Backups locales de auditoría
modelos/legacy_v1/

# Bloqueos de LibreOffice/Word
.~lock.*#
~$*.docx
~$*.doc

# Paquete generado para el sistema editorial
dist/submission/

# Salidas anidadas de Quarto (usar scripts/render_manuscrito.sh para aplanar)
entregables/manuscrito/
entregables/entregables/
!entregables/en/
!entregables/es/
!entregables/fuentes/
!entregables/maestros/

# >>> REPO SLIM POLICY (managed block, do not edit by hand) >>>
# Source of truth: docs/REPO_POLICY.md
# Track only source code, the compact analysis database and final article
# docs. Everything rendered/compiled is regenerated with `make all`.

# --- Quarto / Pandoc / site build output ---
.quarto/
*_files/
site_libs/
*.html.md
*_cache/
**/*.quarto_ipynb

# --- Rendered web and consolidated artifacts ---
entregables/web/
entregables/maestros/
entregables/fuentes/figuras/
entregables/fuentes/figures/
revision_anonima/

# --- External source documents (move to Zenodo / GitHub Releases) ---
fuentes/**/*.pdf
fuentes/**/*.xlsx
fuentes/**/*.xls
fuentes/**/*.zip
datos/raw/pdfs/**/*.pdf
auditoria/**/*.asreview

